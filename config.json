{
  "input": [
    {
      "type": "dbipCountryMMDB",
      "action": "add",
      "args": {
        "uri": "./db-ip/dbip-country-lite-2026-10.mmdb"
      }
    },
    {
      "type": "private",
      "action": "add"
    }
  ],
  "output": [
    {
      "type": "v2rayGeoIPDat",
      "action": "output",
      "args": {
        "outputDir": "./output",
        "outputName": "geoip.dat",
        "wantedList": ["private", "ru"]
      }
    }
  ]
}
